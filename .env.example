# ---------------------------------------------------------------------------
# Lead routing — used by /api/lead for the contact and showing-request forms.
# The route tries these in order and the first configured one wins.
# ---------------------------------------------------------------------------

# 1. PREFERRED: Follow Up Boss inbound webhook / lead-source URL.
# TODO(CJ): still outstanding — ask Sunny to create this in Follow Up Boss
# (or supply the API key below) and set it in the Netlify environment.
# Until one of these is set, submissions are only written to the function logs.
FUB_WEBHOOK_URL=

# Alternative to the webhook: the Follow Up Boss REST API key
# (Follow Up Boss > Admin > API). Requires the code change noted in
# app/api/lead/route.ts. Never commit the real value.
FOLLOW_UP_BOSS_API_KEY=

# 2. FALLBACK: email the lead to Sunny via Resend (https://resend.com).
RESEND_API_KEY=
# Defaults to sunny.chadha@century21.ca if unset.
LEAD_NOTIFY_EMAIL=
# Must be a Resend-verified sender. Defaults to onboarding@resend.dev until
# sunnychadha.com is verified in Resend.
LEAD_NOTIFY_FROM=

# 3. LOCAL ONLY: append each lead to a CSV you can open in Excel.
# Netlify's filesystem is ephemeral, so this is for local capture/testing only.
# e.g. LEAD_CSV_PATH=./leads.csv
LEAD_CSV_PATH=

# ---------------------------------------------------------------------------
# Google Maps Embed API key — enables the map on listing detail pages.
# https://developers.google.com/maps/documentation/embed/get-api-key
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
