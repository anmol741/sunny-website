# ---------------------------------------------------------------------------
# Lead routing — used by /api/lead for the contact and showing-request forms.
# 1. Follow Up Boss and Google Sheets run alongside each other — both receive
#    every lead. Resend (below) and the CSV file are a fallback used only if
#    neither of those is configured or both fail.
# ---------------------------------------------------------------------------

# Follow Up Boss — Events API (Follow Up Boss > Admin > API for the key).
# https://docs.followupboss.com/reference/events-create
# Never commit the real value.
FUB_API_KEY=

# Google Sheets — service account that appends each lead as a row. The
# service account's client email must be shared on the sheet with Editor
# access. Never commit the real private key.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# 2. FALLBACK: email the lead to Sunny via Resend (https://resend.com).
RESEND_API_KEY=
# Defaults to sunny.chadha@century21.ca if unset.
LEAD_NOTIFY_EMAIL=
# Must be a Resend-verified sender. Defaults to onboarding@resend.dev until
# sunnychadha.com is verified in Resend.
LEAD_NOTIFY_FROM=

# 3. LOCAL ONLY: append each lead to a CSV you can open in Excel. Used only if
# neither Follow Up Boss nor Google Sheets is configured, or both fail.
# Netlify's filesystem is ephemeral, so this is for local capture/testing only.
# e.g. LEAD_CSV_PATH=./leads.csv
LEAD_CSV_PATH=

# ---------------------------------------------------------------------------
# Google Maps Embed API key — enables the map on listing detail pages.
# https://developers.google.com/maps/documentation/embed/get-api-key
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
